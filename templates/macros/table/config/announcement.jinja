{%- import "macros/svgs.jinja" as svg -%}

{%- set show_announcement = false %}
{%- macro announcement() %}
<div class="alert bg-info alert-dismissible fade show" style="color: #023d6b;" role="alert">
  <h4 class="alert-heading">       
    {{ svg.announcement_svg | safe }}
    <span class="align-middle">November 9, 10:00 - deNBI-Cloud Maintenance</span>
  </h4>
  deNBI-Cloud will perform unscheduled infrastructure maintenance on November 9.
  JSC-Cloud and GWDG will remain available for your JupyterLab sessions.
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
{%- endmacro %}
